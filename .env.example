# Microsoft 365 用户管理工具 - 环境变量配置模板
# 复制此文件为 .env 并填写实际配置值

# ============================================
# 必需配置项
# ============================================

# Azure AD 应用程序（客户端）ID
# 在 Entra ID 应用注册中获取
CLIENT_ID=your_client_id_here

# Azure AD 目录（租户）ID
# 在 Entra ID 应用注册中获取
TENANT_ID=your_tenant_id_here

# 应用程序的客户端密钥
# 在 Entra ID 应用注册的"证书和密码"中创建
CLIENT_SECRET=your_client_secret_here

# 创建用户或重置密码时的默认密码
# 请确保符合组织的密码策略要求
DEFAULT_PASSWORD=your_default_password_here

# ============================================
# 可选配置项
# ============================================

# 是否强制用户首次登录修改密码（true/false，默认 false）
FORCE_CHANGE_PASSWORD=false

# 默认域名后缀（如 yourdomain.partner.onmschina.cn）
# 使用用户名时会自动添加此域名
DEFAULT_DOMAIN=yourdomain.partner.onmschina.cn

# ============================================
# 邮件通知配置（可选）
# ============================================

# 是否启用邮件通知（true/false，默认 false）
NOTIFICATION_ENABLED=false

# 发件人邮箱地址
NOTIFICATION_FROM_EMAIL=your-email@example.com

# 密送邮箱（多个用逗号分隔）
NOTIFICATION_BCC_EMAILS=admin@example.com

# 通知邮件目标域名（用于邮箱域名转换）
# 例如：如果用户邮箱是 user@yourcorp.partner.onmschina.cn，
# 配置为 example.com 后，通知邮件会发送到 user@example.com
NOTIFICATION_EMAIL_DOMAIN=example.com

# ============================================
# SMTP 配置（用于发送邮件，可选）
# ============================================

# SMTP 服务器地址
SMTP_HOST=smtp.example.com

# SMTP 端口（通常 465 用于 SSL，587 用于 STARTTLS）
SMTP_PORT=465

# SMTP 用户名（通常是邮箱地址）
SMTP_USERNAME=your-email@example.com

# SMTP 密码
SMTP_PASSWORD=your_smtp_password_here

# 是否使用 SSL（true/false，默认 true）
# true: 使用 SMTP_SSL（端口通常为 465）
# false: 使用 STARTTLS（端口通常为 587）
SMTP_USE_SSL=true

